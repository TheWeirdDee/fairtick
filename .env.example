# SERV (openserv.ai). Required for the SERV decider; without it the desk
# still runs quotes and the deterministic threshold/hard-gate path.
SERV_API_KEY=
SERV_MODEL=gpt-5.4-mini

# Optional second provider for a genuine (not shadow-ablated) raw-model
# comparison. If unset, the raw decider calls SERV without serv_shadow_agent
# and is labeled "raw_same_model_no_shadow" in /proof, never presented as an
# independent provider.
RAW_API_KEY=
RAW_API_BASE=

# Chain. Falls back to the public RPC if unset.
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Execution. Absent RH_PRIVATE_KEY => execution.status is always SKIPPED and
# the UI shows "decision only." Never set EXECUTE_LIVE=true without a funded,
# operator-controlled wallet you intend to spend from.
RH_PRIVATE_KEY=
EXECUTE_LIVE=false
MAX_LIVE_USD=25

# Required in the x-operator-secret header on POST /api/decide when
# execute:true. Read-only endpoints do not require it.
OPERATOR_SECRET=

# Durable storage (better-sqlite3, single-file, transactional). Relative to
# the project root.
DATABASE_PATH=./data/fairtick.db

# Managed-order worker poll interval.
WORKER_POLL_INTERVAL_SECONDS=60
