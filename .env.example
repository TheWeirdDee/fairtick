# SERV (openserv.ai). Required for the SERV decider; without it the desk
# still runs quotes and the deterministic threshold/hard-gate path.
SERV_API_KEY=
SERV_MODEL=gpt-5.4-mini

# Optional second provider for a genuine (not shadow-ablated) raw-model
# comparison (not implemented). Removing shadow alone is a feature ablation;
# comparisons must retain identical full prompts, schemas, inputs and settings.
RAW_API_KEY=
RAW_API_BASE=

# Chain. Falls back to the public RPC if unset.
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Mainnet signing is disabled. Do not configure a mainnet private key.
# Public operator address sufficient for read-only balance/allowance simulation.
RH_SENDER_ADDRESS=
EXECUTE_LIVE=false
MAX_LIVE_USD=25

# Required for private order reads/mutations. At least 24 random characters.
# Enter at owner sign-in; exchanged for an expiring HttpOnly cookie. Never place in a public URL.
OPERATOR_SECRET=
# Optional exact external origin behind a reverse proxy.
APP_ORIGIN=

# Implemented SQLite WAL storage. Must reside on a persistent
# volume. Separate-host web/worker deployments require a shared transactional DB.
DATABASE_PATH=./data/fairtick.db

# Reserved configuration: checks currently use a fixed 60-second minimum with
# exponential error backoff capped at 900s. Worker polls due rows every second.
WORKER_POLL_INTERVAL_SECONDS=60

# --- TESTNET DEMO (Robinhood Chain testnet 46630, mock market) ---
# Commented examples: leave unset for mainnet. npm run testnet:* scripts select the testnet themselves.
# Selects the network for web/worker. Default "mainnet". The npm testnet:* scripts set "testnet".
# FAIRTICK_NETWORK=mainnet
# FAIRTICK_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
# Written by npm run testnet:deploy -- --broadcast (mock contract addresses only).
# FAIRTICK_TESTNET_REGISTRY=data/testnet/registry.testnet.json
# Never the mainnet database; enforced at startup.
# TESTNET_DATABASE_PATH=./data/testnet/fairtick-testnet.db
# Separate testnet-only wallet. Create with: npm run testnet:wallet (never paste a key here by hand
# from another wallet; the mainnet key and sender are refused).
# RH_TESTNET_PRIVATE_KEY=
# RH_TESTNET_SENDER_ADDRESS=
# The testnet worker signs only when this is exactly "true" and the RPC reports chain 46630.
# FAIRTICK_TESTNET_EXECUTE=false
